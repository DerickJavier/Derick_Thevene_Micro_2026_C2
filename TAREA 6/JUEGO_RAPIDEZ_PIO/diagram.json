{
  "version": 1,
  "author": "Juego de Rapidez - ITLA",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -120, "left": 150, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "led2", "top": -120, "left": 250, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -60, "left": 150, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -60, "left": 250, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 120, "left": 150, "attrs": { "color": "blue", "label": "BTN1" } },
    { "type": "wokwi-pushbutton", "id": "btn2", "top": 120, "left": 280, "attrs": { "color": "red", "label": "BTN2" } }
  ],
  "connections": [
    [ "$serialMonitor:RX", "esp:TX0", "", [] ],
    [ "$serialMonitor:TX", "esp:RX0", "", [] ],
    [ "esp:D2", "r1:1", "red", [ "v0" ] ],
    [ "r1:2", "led1:A", "red", [ "v0" ] ],
    [ "led1:C", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:D15", "r2:1", "green", [ "v0" ] ],
    [ "r2:2", "led2:A", "green", [ "v0" ] ],
    [ "led2:C", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:D4", "btn1:1.l", "blue", [ "v0" ] ],
    [ "btn1:2.l", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:D13", "btn2:1.l", "orange", [ "v0" ] ],
    [ "btn2:2.l", "esp:GND.1", "black", [ "v0" ] ]
  ]
}
